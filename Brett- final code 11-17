import java.util.*;
class Receipt extends Order {
    private final String[] paymentMethods = {"Credit Card", "Cash", "Mobile Pay"};
    
private String selectedPaymentMethod; 
	private static final HashSet rewardsMember = new HashSet<>();
	private String phoneNumber; 
    protected Scanner input = new Scanner (System.in);
    public double cashPayment;
    public void printReceipt(Order order) 
    {
    	System.out.print("Would you like to provide a phone number for rewards? (yes/no): ");
        String response = input.nextLine();
        System.out.println(); 
        if (response.equals("yes")) {
            System.out.print("Enter your phone number: ");
            phoneNumber = input.nextLine();
            rewardsMember.add(phoneNumber); // Add phone number to rewards system
            System.out.println("Your rewards are in!");
        } else {
            System.out.println("You can sign up for rewards online!");
        }
       System.out.println();
       System.out.println("Choose your payment method:");
                for (int i = 0; i < paymentMethods.length; i++) {
            System.out.println((i + 1) + ". " + paymentMethods[i]);
        }
        int paymentChoice;
        while (true) {
            System.out.print("Enter the number for payment method: ");
            paymentChoice = input.nextInt();
            if (paymentChoice == 1 || paymentChoice == 3 && paymentChoice <= paymentMethods.length) {
                selectedPaymentMethod = paymentMethods[paymentChoice - 1];
                break; 
            } else if (paymentChoice == 2){
                System.out.printf("Total Price: $%.2f%n", (order.getTotalPrice() * 1.08)); 
            	System.out.println("How much cash would you like to pay with?");
            	 cashPayment = input.nextDouble(); 
            	 
            	break;
            }
            else  {
                System.out.println("Invalid selection, please try again.");
            }
        }
        
        System.out.println();
        System.out.println("------ Receipt ------");
        order.printInfo();
        if (phoneNumber != null) {
            System.out.println("Phone Number: " + phoneNumber);
            System.out.println("Rewards Member: Yes");
        } else {
            System.out.println("Rewards Member: No");
        }
        System.out.println("Payment Method: " + paymentChoice);
        if (paymentChoice == 2) {
        	System.out.println("Cash provided: $" + cashPayment); 
        	System.out.printf("Change to receive: $%.2f%n" , Math.abs( (cashPayment - (order.getTotalPrice() + order.getTax()))));
        	}
        System.out.println("Payment Successful");
        System.out.println("---------------------");
        System.out.println("Thank you for choosing Chick-fil-A!");
    }
}
